# Billing service
BILLING_HOST=0.0.0.0
BILLING_PORT=8080

# inventory service
INVENTORY_HOST=0.0.0.0
INVENTORY_PORT=8080

# gateway service
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000
INVENTORY_API_URL=http://inventory-app-service:8080

# inventory PostgreSQL
INVENTORY_DB_HOST=inventory-db-service
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=password

# Billing PostgreSQL
BILLING_DB_HOST=billing-db-service
BILLING_DB_PORT=5432
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=password

# RabbitMQ
RABBITMQ_HOST=rabbit-queue-service
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=rabbit_user
RABBITMQ_DEFAULT_PASS=password
RABBITMQ_QUEUE=billing_queue
